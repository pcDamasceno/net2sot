# Copy to net2sot/.env and fill in. discovery.py loads it from its own
# directory at startup. .env is git-ignored, so real credentials never land in
# version control. These values override net2sot/settings.yaml and
# inventory/defaults.yaml; a real environment variable wins over both.

# ── NetBox ───────────────────────────────────────────────────────────
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=
# Set false for a NetBox with a self-signed certificate.
NETBOX_VALIDATE_CERTS=true
# Optional: scope the whole run to an existing netbox-branching branch
# instead of committing straight to main.
# NETBOX_BRANCH=rediscovery

# ── Device credentials ───────────────────────────────────────────────
# SSH login used for every host that does not pin its own credentials
# in inventory/hosts.yaml.
DEVICE_USERNAME=admin
DEVICE_PASSWORD=

# ── Run defaults (optional) ──────────────────────────────────────────
# SITE_NAME=prod
# DEVICE_ROLE=unknown
# TENANT=
# COLLECTOR=napalm
# SINK=netbox
# CREATE_CABLES=false
# DEBUG=false
# LOG_FILE=AUTO
# OUTPUT_FILE=AUTO
